<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.announce.mapper.user.PasswordResetTokenMapper">

    <resultMap id="BaseResultMap" type="com.campus.announce.entity.PasswordResetToken">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="token" property="token" jdbcType="VARCHAR"/>
        <result column="expiry_date" property="expiryDate" jdbcType="TIMESTAMP"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.campus.announce.entity.PasswordResetToken" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_password_reset_token (user_id, token, expiry_date, create_time)
        VALUES (#{userId}, #{token}, #{expiryDate}, #{createTime})
    </insert>

    <select id="selectByToken" parameterType="String" resultMap="BaseResultMap">
        SELECT id, user_id, token, expiry_date, create_time
        FROM sys_password_reset_token
        WHERE token = #{token}
    </select>

    <delete id="deleteByUserId" parameterType="Long">
        DELETE FROM sys_password_reset_token WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByToken" parameterType="String">
        DELETE FROM sys_password_reset_token WHERE token = #{token}
    </delete>

    <delete id="deleteExpiredTokens">
        DELETE FROM sys_password_reset_token WHERE expiry_date &lt; NOW()
    </delete>

</mapper>
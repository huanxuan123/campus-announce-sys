<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.announce.mapper.department.DepartmentMapper">

    <resultMap id="BaseResultMap" type="com.campus.announce.entity.Department">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="dept_name" property="deptName" jdbcType="VARCHAR"/>
        <result column="dept_code" property="deptCode" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, dept_name, dept_code, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_department
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_department
        WHERE dept_code = #{deptCode}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_department
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.campus.announce.entity.Department" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_department (dept_name, dept_code, create_time, update_time)
        VALUES (#{deptName}, #{deptCode}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.campus.announce.entity.Department">
        UPDATE sys_department
        SET dept_name = #{deptName},
            dept_code = #{deptCode},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_department
        WHERE id = #{id}
    </delete>

    <select id="countByCode" resultType="int">
        SELECT COUNT(*)
        FROM sys_department
        WHERE dept_code = #{deptCode}
    </select>

</mapper>

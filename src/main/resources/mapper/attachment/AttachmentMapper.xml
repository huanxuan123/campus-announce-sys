<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.announce.mapper.attachment.AttachmentMapper">

    <resultMap id="BaseResultMap" type="com.campus.announce.entity.Attachment">
        <id column="id" property="id"/>
        <result column="announcement_id" property="announcementId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="upload_time" property="uploadTime"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_attachment WHERE id = #{id}
    </select>

    <select id="selectByAnnouncementId" resultMap="BaseResultMap">
        SELECT * FROM sys_attachment WHERE announcement_id = #{announcementId} ORDER BY upload_time DESC
    </select>

    <insert id="insert" parameterType="com.campus.announce.entity.Attachment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_attachment (announcement_id, file_name, file_path, file_size, file_type)
        VALUES (#{announcementId}, #{fileName}, #{filePath}, #{fileSize}, #{fileType})
    </insert>

    <delete id="deleteById">
        DELETE FROM sys_attachment WHERE id = #{id}
    </delete>

    <delete id="deleteByAnnouncementId">
        DELETE FROM sys_attachment WHERE announcement_id = #{announcementId}
    </delete>

</mapper>
